{
  "name": "qa_board",
  "private": true,
  "version": "0.2.0",
  "description": "Q&A system",
  "engine": {
    "node": "18",
    "npm": "9"
  },
  "scripts": {
    "prepare": "husky install",
    "dev": "nuxi dev --spa",
    "build": "nuxi generate --spa",
    "prettier": "prettier --write \"src/**/*.{js,ts,vue}\"",
    "postversion": "git push && git push --tags"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gcpug/qa_board.git"
  },
  "author": "sinmetal",
  "bugs": {
    "url": "https://github.com/gcpug/qa_board/issues"
  },
  "homepage": "https://github.com/gcpug/qa_board#readme",
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "dependencies": {
    "@pinia/nuxt": "^0.11.0",
    "firebase": "^11.7.3",
    "marked": "^15.0.11",
    "nuxt": "^3.17.3",
    "pinia": "^3.0.2",
    "sanitize-html": "^2.17.0"
  },
  "devDependencies": {
    "@types/sanitize-html": "^2.16.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "prettier": "^3.5.3"
  },
  "overrides": {
    "vue": "latest"
  }
}
